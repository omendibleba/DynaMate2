# ── Secrets & local config ────────────────────────────────────────────────────
.env
.dynamate/
.claude/

# ── Backup / scratch files ────────────────────────────────────────────────────
README_ycolon.md
nohup.out
app_*_backup.py
*.bak

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Molecular simulation generated outputs ────────────────────────────────────
# These are regenerated each time the tutorial notebook is run.
# Reference copies are committed in tutorials/sample_outputs/.
tutorials/*.traj
tutorials/*.log
tutorials/*.inp
tutorials/*.xyz
tutorials/*.png
# Do NOT ignore sample_outputs — those are committed reference files
!tutorials/sample_outputs/
!tutorials/sample_outputs/**

# ── State directories (auto-generated at runtime) ────────────────────────────
tutorials/paper_tests_*_state/

# ── Large model binaries ──────────────────────────────────────────────────────
tutorials/models/
*.model
*-lammps.pt

# ── Misc large files ──────────────────────────────────────────────────────────
Dynamate1_paper.pdf
DynaMate2-V3.0.docx

# ── UI runtime state (Gradio + FastAPI backend) ───────────────────────────────
# Session/conversation state, not source — regenerated per user. Tool source
# files under ui_state/tools/*.py are intentionally still tracked.
ui_state/conversations.db
ui_state/conversations.db-shm
ui_state/conversations.db-wal
ui_state/pool_state.json
ui_state/threads.json
ui_state/uploads/
ui_state/tools/__pycache__/

# ── React frontend build artefacts ────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
backend/__pycache__/

# ── Container runtime data (run.sh's default persistent data dir) ────────────
dynamate-data/
*.sif
