## Define your API key, and rename this file to .env

OPENAI_API_KEY = ''

## Optional: LangSmith tracing (https://smith.langchain.com) for debugging/observability.
## Not required for DynaMate2 to work -- leave LANGSMITH_TRACING=false (or delete these
## lines) unless you have your own LangSmith account and API key. Leaving TRACING=true
## with no valid API key causes a harmless but noisy background error on every run
## ("Failed to send compressed multipart ingest ... 401 Unauthorized").
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=''
LANGSMITH_PROJECT=''
